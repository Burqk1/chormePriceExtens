{
  "manifest_version": 3,
  "name": "Fiyat Takip — Trendyol, Hepsiburada & Amazon TR",
  "version": "2.0.0",
  "description": "Trendyol, Hepsiburada ve Amazon TR için fiyat geçmişi takip ve karşılaştırma aracı",
  "permissions": ["storage", "activeTab", "tabs", "alarms", "notifications"],
  "host_permissions": [
    "https://www.trendyol.com/*",
    "https://www.hepsiburada.com/*",
    "https://www.amazon.com.tr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    { 
      "matches": [
        "https://www.trendyol.com/*",
        "https://www.hepsiburada.com/*",
        "https://www.amazon.com.tr/*"
      ],
      "js": ["lib/chart.min.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
